# Kor'tana Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# ==========================================================
# Core Environment Settings
# ==========================================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ==========================================================
# AI & LLM Provider Keys
# ==========================================================
# Google Gemini
GEMINI_API_KEY=your-gemini-key-here
GOOGLE_API_KEY=your-google-api-key
GOOGLE_PROJECT_ID=your-project-id

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Groq
GROQ_API_KEY=gsk_...

# Vector Database
PINECONE_API_KEY=pcsk_...
PINECONE_ENVIRONMENT=us-east-1

# ==========================================================
# Integration Keys
# ==========================================================
# GitHub
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=KOR-TANA
GITHUB_REPO=kortana

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-client-id

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AWS
AWS_BACKUP_ACCESS_KEY_ID=AKIA...
AWS_BACKUP_SECRET_ACCESS_KEY=your-aws-secret-key

# Google Drive (Legacy)
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key-here

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ==========================================================
# Database Configuration
# ==========================================================
# PostgreSQL Connection (full URL format)
DATABASE_URL=postgresql://postgres:your-secure-password@localhost:5432/kortana_db

# PostgreSQL Connection (individual fields)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kortana
DB_USER=postgres
DB_PASSWORD=your-secure-password

# ==========================================================
# Security & Session
# ==========================================================
SECRET_KEY=your-secret-key-change-in-production
HEARTBEAT_TOKEN=your-heartbeat-token
SESSION_SALT=your-session-salt

# ==========================================================
# CORS Configuration
# ==========================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==========================================================
# Logging Configuration
# ==========================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ==========================================================
# Rate Limiting
# ==========================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ==========================================================
# Timeouts
# ==========================================================
REQUEST_TIMEOUT=30
API_TIMEOUT=15

# ==========================================================
# Optional Third-party Services
# ==========================================================
LITELLM_API_KEY=
