# Daemon service image — minimal Python worker, no frontend, no Node
FROM python:3.11-slim AS builder
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-warn-script-location --no-cache-dir --compile \
    -r requirements.txt

# --- Runtime ---
FROM python:3.11-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    libpq5 \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN groupadd -r kortana && useradd -r -g kortana -u 1000 -m kortana

COPY --from=builder --chown=kortana:kortana /usr/local/lib /usr/local/lib
COPY --from=builder --chown=kortana:kortana /usr/local/bin /usr/local/bin
COPY --chown=kortana:kortana . .

RUN mkdir -p /app/tmp /app/logs \
    && chown -R kortana:kortana /app/tmp /app/logs \
    && chmod 755 /app/tmp /app/logs

ENV PYTHONPATH="/app" \
    REPO_ROOT="/app" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER kortana

CMD ["sh", "start_daemon.sh"]
