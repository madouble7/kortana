{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "sh -c 'python -m alembic upgrade head && uvicorn src.kortana.main:app --host 0.0.0.0 --port $PORT --log-level info'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "env": {
    "ENVIRONMENT": "production",
    "PORT": "8000",
    "LOG_LEVEL": "info",
    "KORTANA_DAEMON_IN_PROCESS": "false",
    "KORTANA_AUTONOMOUS_MODE": "true",
    "AUTONOMY_CYCLE_INTERVAL": "120"
  }
}
