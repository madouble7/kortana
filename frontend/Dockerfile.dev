# ============================================
# Kor'tana Frontend - Development Dockerfile
# ============================================
# Optimized for hot-reloading and development

FROM node:20-alpine

WORKDIR /app

# Install dependencies for better build performance
RUN apk add --no-cache git

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm install && npm cache clean --force

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Set environment
ENV NODE_ENV=development

# Start development server
CMD ["npm", "start"]
