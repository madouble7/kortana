# Production Environment Variables for Deployment

# ============================================
# Backend API Configuration
# ============================================
VITE_API_URL=https://kortana-backend.vercel.app
VITE_WS_URL=wss://kortana-backend.vercel.app

# ============================================
# App Configuration
# ============================================
VITE_APP_NAME=Kor'tana
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_CHAT=true
VITE_ENABLE_TASKS=true
VITE_ENABLE_AUTONOMY=true
VITE_ENABLE_GITHUB=true
VITE_ENABLE_MEMORY=true
