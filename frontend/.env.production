# Production Environment Variables for Deployment

# ============================================
# Backend API Configuration
# ============================================
# Intentionally unset in production builds.
# The FastAPI host injects window.__KORTANA__ at request time so the frontend
# stays portable across local LAN, container, and deployed environments.

# ============================================
# App Configuration
# ============================================
VITE_APP_NAME=Kor'tana
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_CHAT=true
VITE_ENABLE_TASKS=true
VITE_ENABLE_AUTONOMY=true
VITE_ENABLE_GITHUB=true
VITE_ENABLE_MEMORY=true
