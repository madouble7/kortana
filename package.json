{
  "name": "kortana",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kor'tana - AI-powered GitHub integration service with React frontend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "type-check": "npm --prefix frontend run type-check",
    "test": "npm --prefix frontend run type-check && npm --prefix vscode-extension test",
    "legacy:root-ui:dev": "vite",
    "legacy:root-ui:build": "tsc && vite build",
    "legacy:root-ui:lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "legacy:root-ui:preview": "vite preview",
    "legacy:node-server:dev": "nodemon --exec ts-node src/server.ts",
    "legacy:node-server:build": "npx tsc",
    "legacy:node-server:start": "node dist/server.js"
  },
  "keywords": [
    "github",
    "ai",
    "gemini",
    "analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^22.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.2"
  }
}
