{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: FastAPI (src.kortana.main)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.kortana.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "jinja": true,
            "envFile": "${workspaceFolder}/.env",
            "windows": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}\\backend;${workspaceFolder}\\backend\\src"
                }
            },
            "linux": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/backend/src"
                }
            },
            "osx": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/backend/src"
                }
            }
        },
        {
            "name": "Backend: Legacy main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/main.py",
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "windows": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}\\backend;${workspaceFolder}\\backend\\src"
                }
            },
            "linux": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/backend/src"
                }
            },
            "osx": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/backend/src"
                }
            }
        },
        {
            "name": "Backend: FastAPI (awaken root + monitoring)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.kortana.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "jinja": true,
            "envFile": "${workspaceFolder}/.env",
            "windows": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}\\backend;${workspaceFolder}\\backend\\src"
                }
            },
            "linux": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/backend/src"
                }
            },
            "osx": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/backend/src"
                }
            },
            "preLaunchTask": "awaken: root ui + monitoring"
        },
        {
            "name": "Backend: FastAPI (awaken frontend + monitoring)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.kortana.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "jinja": true,
            "envFile": "${workspaceFolder}/.env",
            "windows": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}\\backend;${workspaceFolder}\\backend\\src"
                }
            },
            "linux": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/backend/src"
                }
            },
            "osx": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/backend/src"
                }
            },
            "preLaunchTask": "awaken: frontend ui + monitoring"
        },
        {
            "name": "Root UI: Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/src",
            "preLaunchTask": "root: ui dev"
        },
        {
            "name": "Root UI: Chrome (existing session)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/src"
        },
        {
            "name": "Frontend UI: Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5174",
            "webRoot": "${workspaceFolder}/frontend/src",
            "preLaunchTask": "frontend: ui dev"
        },
        {
            "name": "Frontend UI: Chrome (existing session)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5174",
            "webRoot": "${workspaceFolder}/frontend/src"
        },
        {
            "name": "Monitoring: Grafana",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "monitoring: up"
        },
        {
            "name": "Monitoring: Grafana (existing session)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Monitoring: Prometheus",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:9090",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "monitoring: up"
        },
        {
            "name": "Monitoring: Prometheus (existing session)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:9090",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Extension: Control Panel",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"
            ],
            "outFiles": [
                "${workspaceFolder}/vscode-extension/out/**/*.js"
            ],
            "preLaunchTask": "extension: watch"
        }
    ],
    "compounds": [
        {
            "name": "KORTANA: Backend + Root UI",
            "configurations": [
                "Backend: FastAPI (src.kortana.main)",
                "Root UI: Chrome"
            ]
        },
        {
            "name": "KORTANA: Backend + Frontend UI",
            "configurations": [
                "Backend: FastAPI (src.kortana.main)",
                "Frontend UI: Chrome"
            ]
        },
        {
            "name": "KORTANA: Awaken Everything (Root UI + Monitoring)",
            "configurations": [
                "Backend: FastAPI (awaken root + monitoring)",
                "Root UI: Chrome (existing session)",
                "Monitoring: Grafana (existing session)"
            ]
        },
        {
            "name": "KORTANA: Awaken Everything (Frontend UI + Monitoring)",
            "configurations": [
                "Backend: FastAPI (awaken frontend + monitoring)",
                "Frontend UI: Chrome (existing session)",
                "Monitoring: Grafana (existing session)"
            ]
        },
        {
            "name": "KORTANA: Control Panel + Backend",
            "configurations": [
                "Extension: Control Panel",
                "Backend: FastAPI (src.kortana.main)"
            ]
        },
        {
            "name": "KORTANA: Monitoring Dashboards",
            "configurations": [
                "Monitoring: Grafana",
                "Monitoring: Prometheus (existing session)"
            ]
        }
    ]
}
