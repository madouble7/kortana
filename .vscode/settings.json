{
    "python.envFile": "${workspaceFolder}/.env",
    "python.testing.pytestEnabled": true,
    "python.testing.cwd": "${workspaceFolder}/backend",
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.autoTestDiscoverOnSaveEnabled": false,
    "python.analysis.extraPaths": [
        "./backend",
        "./backend/src",
        "./backend/src/kortana",
        "./src",
        "./app"
    ],
    "python.analysis.include": [
        "./backend/**/*.py",
        "./src/**/*.py",
        "./app/**/*.py",
        "./tests/**/*.py",
        "./*.py"
    ],
    "python.analysis.exclude": [
        "**/node_modules",
        "**/.backup",
        "**/.benchmarks",
        "**/.kortana",
        "**/.kortana-runtime",
        "**/.mypy_cache",
        "**/.pytest_cache",
        "**/.ruff_cache",
        "**/__pycache__",
        "**/build",
        "**/dist",
        "**/htmlcov",
        "**/obsolete",
        "**/test_results"
    ],
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "eslint.workingDirectories": [
        {
            "directory": ".",
            "changeProcessCWD": true
        },
        {
            "directory": "frontend",
            "changeProcessCWD": true
        }
    ],
    "terminal.integrated.env.windows": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "${workspaceFolder}\\backend;${workspaceFolder}\\backend\\src;${workspaceFolder}\\src"
    },
    "terminal.integrated.env.linux": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/backend/src:${workspaceFolder}/src"
    },
    "task.allowAutomaticTasks": "on",
    "debug.onTaskErrors": "abort",
    "debug.openDebug": "openOnSessionStart",
    "debug.internalConsoleOptions": "neverOpen",
    "testing.automaticallyOpenPeekView": "never",
    "files.exclude": {
        "**/.benchmarks": true,
        "**/coverage": true,
        "**/htmlcov": true,
        "**/test_results": true,
        "**/*.db": true,
        "backend/celerybeat-schedule.dat": true,
        "logs/archive": true,
        "obsolete": true
    },
    "search.exclude": {
        "**/.benchmarks": true,
        "**/coverage": true,
        "**/htmlcov": true,
        "**/test_results": true,
        "**/*.db": true,
        "backend/celerybeat-schedule.dat": true,
        "logs/archive": true,
        "obsolete": true
    },
    "files.watcherExclude": {
        "**/.benchmarks/**": true,
        "**/coverage/**": true,
        "**/htmlcov/**": true,
        "**/test_results/**": true,
        "logs/archive/**": true,
        "obsolete/**": true
    },
    "search.followSymlinks": false,
    "explorer.fileNesting.patterns": {
        "requirements.txt": "requirements-dev.txt, pytest.ini, alembic.ini",
        "package.json": "package-lock.json, tsconfig*.json, vite.config.*, postcss.config.*, tailwind.config.*, .eslintrc.cjs",
        "docker-compose.yml": "docker-compose.*.yml, Dockerfile*"
    },
    "pieces.cloudCapabilities": "Local"
}
