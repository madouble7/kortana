              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "$B > 20",
                "hide": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "C",
                "type": "math"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Kor'tana rate-limit events are surging.",
            "description": "A sharp increase in limited traffic usually indicates abuse, a polling bug, or a real traffic surge."
          },
          "labels": {
            "service": "kortana",
            "severity": "medium"
          }
        },
        {
