{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "kortana-rate-limit-proxy-trust",
      "folder": "Kor'tana Observability",
      "interval": "60s",
      "rules": [
        {
          "uid": "krt-health-rate-limit",
          "title": "Kor'tana health endpoint rate-limited",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "$DS_PROMETHEUS_UID",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "model": {
                "editorMode": "code",
                "expr": "sum(rate(kortana_rate_limit_events_total{route=\"/api/health\"}[2m]))",
                "intervalMs": 1000,
                "legendFormat": "__auto",
                "maxDataPoints": 43200,
                "range": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0,
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "avg"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "hide": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "reducer": "last",
                "refId": "B",
                "type": "reduce"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "$B > 0",
                "hide": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "C",
                "type": "math"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "The health endpoint is being rate-limited.",
            "description": "Kor'tana should never emit rate-limit events for /api/health. Treat this as a regression in limiter bypass behavior."
          },
          "labels": {
            "service": "kortana",
            "severity": "critical"
          }
        },
        {
          "uid": "krt-spoof-ignored-spike",
          "title": "Kor'tana spoof-ignored spike",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "$DS_PROMETHEUS_UID",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "editorMode": "code",
                "expr": "sum(rate(kortana_rate_limit_events_total{status=\"spoof-ignored\"}[5m]))",
                "intervalMs": 1000,
                "legendFormat": "__auto",
                "maxDataPoints": 43200,
                "range": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0,
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "avg"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "hide": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "reducer": "last",
                "refId": "B",
                "type": "reduce"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "$B > 5",
                "hide": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "C",
                "type": "math"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Spoof-ignored events are spiking.",
            "description": "Kor'tana is ignoring multiple untrusted X-Forwarded-For headers. Verify trusted proxy configuration and investigate spoof attempts."
          },
          "labels": {
            "service": "kortana",
            "severity": "high"
          }
        },
        {
          "uid": "krt-proxy-mode-collapse",
          "title": "Kor'tana proxy identity collapse",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "$DS_PROMETHEUS_UID",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "editorMode": "code",
                "expr": "count(sum by (client_ip) (rate(kortana_rate_limit_events_total{status!=\"spoof-ignored\"}[5m])) > 0)",
                "intervalMs": 1000,
                "legendFormat": "__auto",
                "maxDataPoints": 43200,
                "range": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0,
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "avg"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "hide": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "reducer": "last",
                "refId": "B",
                "type": "reduce"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "$B < 2",
                "hide": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "C",
                "type": "math"
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Most traffic is collapsing onto one effective client IP.",
            "description": "Kor'tana is no longer seeing normal client IP diversity. Check proxy mode, trusted proxies, and X-Forwarded-For preservation."
          },
          "labels": {
            "service": "kortana",
            "severity": "high"
          }
        },
