# Server Configuration
PORT=3001
NODE_ENV=production

# API Key for production deployment (optional but recommended)
# Set this to require X-API-Key header on all API requests in production
API_KEY=your_random_secure_api_key_here

# CORS Configuration
# Comma-separated list of allowed origins for production (e.g., "https://example.com,https://app.example.com")
# Leave empty in development for unrestricted access
ALLOWED_ORIGINS=

# GitHub Configuration
# Get your token from: https://github.com/settings/tokens/new
# Required scopes: repo, read:user
GITHUB_TOKEN=your_github_token_here

# Gemini AI Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
