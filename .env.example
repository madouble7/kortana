# Development environment template (copy to .env)
# Never commit real secrets.

# Runtime
ENVIRONMENT=development
LOG_LEVEL=debug
DEBUG=true
PORT=8000
API_PORT=8000
FRONTEND_PORT=5173

# URLs
VITE_API_URL=http://localhost:8000
KORTANA_BACKEND_URL=http://localhost:8000
KORTANA_FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Local topology
# Development defaults to the embedded daemon for zero-friction startup.
KORTANA_DAEMON_IN_PROCESS=true
AUTONOMY_DAEMON_ENABLED=true
AUTONOMY_CYCLE_INTERVAL=120
KORTANA_AUTONOMOUS_MODE=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./backend/kortana.db
DB_USER=kortana
DB_PASSWORD=kortana_dev
DB_NAME=kortana_db
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev

# Security
SECRET_KEY=change-me-in-development
SESSION_SALT=change-me-in-development
HEARTBEAT_TOKEN=change-me-in-development
GITHUB_WEBHOOK_SECRET=

# External APIs
GITHUB_TOKEN=
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted anywhere Gemini access is required.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Model lanes: core keeps stable defaults, experimental adds room to explore,
# quarantine is for explicit inspection of suspicious or untrusted models.
KORTANA_MODEL_USAGE_LANE=core
KORTANA_OPENAI_STATEFUL_CHAT_ENABLED=true
KORTANA_CORE_MODELS=
KORTANA_EXPERIMENTAL_MODELS=
KORTANA_QUARANTINE_MODELS=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
