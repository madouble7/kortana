# Environment Configuration - Development (COPY and RENAME to .env)
# This file serves as a template. Never commit actual secrets.

# Database Configuration
DB_USER=kortana
DB_PASSWORD=kortana_dev
DB_NAME=kortana_db
DB_PORT=5432

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev

# API Configuration
API_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=debug
DEBUG=true

# External APIs (Add your keys here)
GITHUB_TOKEN=
GOOGLE_API_KEY=
GROQ_API_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
