{
  "entities": {
    "Memory": {
      "title": "Memory",
      "description": "A stored memory or conversation summary for Kor'tana.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user ID who owns this memory."
        },
        "content": {
          "type": "string",
          "description": "The content of the memory."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the memory was created."
        }
      },
      "required": ["uid", "content", "timestamp"]
    },
    "Task": {
      "title": "Task",
      "description": "An autonomous task for the system.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user ID who owns this task."
        },
        "description": {
          "type": "string",
          "description": "Task description."
        },
        "priority": {
          "type": "string",
          "enum": ["urgent", "normal", "low"],
          "description": "Task priority."
        },
        "status": {
          "type": "string",
          "enum": ["available", "claimed", "in_progress", "completed"],
          "description": "Task status."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the task was created."
        }
      },
      "required": ["uid", "description", "priority", "status", "created_at"]
    },
    "RitualMemory": {
      "title": "RitualMemory",
      "description": "A memory recorded during a ritual session with Kor'tana.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user ID who owns this memory."
        },
        "content": {
          "type": "string",
          "description": "The content of the ritual memory."
        },
        "emotionalWeight": {
          "type": "number",
          "description": "The emotional weight of the memory (0 to 1)."
        },
        "stateAtCreation": {
          "type": "string",
          "description": "The ritual state when the memory was created."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the memory was created."
        }
      },
      "required": ["uid", "content", "emotionalWeight", "stateAtCreation", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}/memories": {
      "schema": "Memory",
      "description": "User's personal memories and conversation summaries."
    },
    "users/{userId}/ritual_memories": {
      "schema": "RitualMemory",
      "description": "Memories recorded during ritual sessions."
    },
    "tasks": {
      "schema": "Task",
      "description": "Global task queue for autonomous operations."
    }
  }
}
