{
  "family": "kortana",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "taskRoleArn": "REPLACE_TASK_ROLE_ARN",
  "executionRoleArn": "REPLACE_EXEC_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "REPLACED_BY_CI",
      "portMappings": [{"containerPort": 8080, "protocol": "tcp"}],
      "essential": true,
      "environment": [
        {"name": "USE_AWS_SECRETS", "value": "true"},
        {"name": "IMAGE_MODEL_ID", "value": "imagen-4.0-generate-001"},
        {"name": "IMAGE_CACHE_TTL_SECONDS", "value": "3600"},
        {"name": "GOOGLE_API_KEY_SECRET_ARN", "value": "arn:aws:secretsmanager:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:secret:kortana/google/api-key-PLACEHOLDER"},
        {"name": "PORT", "value": "8080"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/kortana",
          "awslogs-region": "YOUR_AWS_REGION",
          "awslogs-stream-prefix": "api"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -fsS http://localhost:8080/ready || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}