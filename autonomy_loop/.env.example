# Gemini API Key
GEMINI_API_KEY=

# Backend API Port (default 3000 for Express, 8000 for Python)
KORTANA_API_PORT=3000

# Frontend API Base URL
VITE_API_BASE=/api

# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET=

# GitHub App Credentials
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
